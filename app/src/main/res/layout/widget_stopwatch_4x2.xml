<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_frosted_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/stopwatch_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/stopwatch_header_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_stopwatch" />

        <TextView
            android:id="@+id/stopwatch_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_stopwatch_title"
            android:textColor="#FF94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/stopwatch_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="false"
                android:fontFeatureSettings="tnum"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stopwatch_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/stopwatch_actions_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/stopwatch_secondary_btn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/action_reset"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/stopwatch_toggle_btn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/action_start"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/stopwatch_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_widget_divider_dark"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/stopwatch_no_laps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_no_laps"
        android:textColor="#66FFFFFF"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/stopwatch_widget_laps_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:visibility="gone" />
</LinearLayout>
