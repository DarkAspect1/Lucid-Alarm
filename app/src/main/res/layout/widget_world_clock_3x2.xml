<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_frosted_dark"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="9dp"
    android:paddingEnd="13dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:id="@+id/world_clock_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/world_clock_header_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_world_clock" />

        <TextView
            android:id="@+id/world_clock_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_world_clock"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/world_clock_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_widget_divider_dark"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/world_clock_no_cities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/no_cities_added"
        android:textColor="#66FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/world_clock_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />
</LinearLayout>
