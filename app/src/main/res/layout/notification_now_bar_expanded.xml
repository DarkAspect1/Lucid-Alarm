<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom "Now Bar" layout rendered by RemoteViews inside the ongoing Timer/Stopwatch notification.
  Only RemoteViews-supported widgets are used (FrameLayout, LinearLayout, ImageView, TextView) and
  every dynamic piece (background bitmap, accent squircle, icons, readouts, action labels and
  action PendingIntents) is bound from Kotlin.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/now_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Full-bleed accent-tinted pill background, generated in Kotlin. -->
    <ImageView
        android:id="@+id/now_bar_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:contentDescription="@string/now_bar_background_desc" />

    <LinearLayout
        android:id="@+id/now_bar_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <!-- Upper row: squircle badge + live readout. Tapping it opens the app. -->
        <LinearLayout
            android:id="@+id/now_bar_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="false">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp">

                <!-- Accent-tinted 18dp squircle behind the icon. -->
                <ImageView
                    android:id="@+id/now_bar_badge_bg"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:contentDescription="@string/now_bar_badge_desc" />

                <!-- White stopwatch / hourglass glyph. -->
                <ImageView
                    android:id="@+id/now_bar_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:contentDescription="@string/now_bar_timer_icon_desc" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <Chronometer
                    android:id="@+id/now_bar_chronometer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="34sp"
                    android:textColor="#FFFFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/now_bar_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="15sp"
                    android:textColor="#FFE2E4EC"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lower row: split actions with a centered divider. -->
        <LinearLayout
            android:id="@+id/now_bar_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/now_bar_action_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="false" />

            <ImageView
                android:id="@+id/now_bar_divider"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#38FFFFFF"
                android:importantForAccessibility="no"
                android:contentDescription="@string/now_bar_divider_desc" />

            <TextView
                android:id="@+id/now_bar_action_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
