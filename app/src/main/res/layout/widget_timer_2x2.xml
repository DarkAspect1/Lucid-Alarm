<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_frosted_dark"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/timer_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/timer_header_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hourglass" />

        <TextView
            android:id="@+id/timer_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_timer_title"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/timer_ring_image"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_timer_title"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <Chronometer
                android:id="@+id/timer_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:fontFeatureSettings="tnum"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/timer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE2E8F0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/timer_presets_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/timer_preset_1"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="1m"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/timer_preset_5"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="5m"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/timer_preset_10"
            android:layout_width="34dp"
            android:layout_height="24dp"
            android:contentDescription="10m"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/timer_controls_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/timer_reset_btn"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/action_reset"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/timer_play_pause_btn"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:contentDescription="@string/action_pause"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
